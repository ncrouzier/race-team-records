{
  "scripts": {
    "start": "node server.js",
    "build:css": "node scripts/build-css.mjs",
    "build:ng:dev": "npx ng build --configuration development",
    "build:ng:prod": "npx ng build --configuration production",
    "copy:fonts": "mkdir -p public/dist/fonts && cp public/libs/fontawesome/fonts/fontawesome-webfont.eot public/libs/fontawesome/fonts/fontawesome-webfont.ttf public/libs/fontawesome/fonts/fontawesome-webfont.woff public/libs/fontawesome/fonts/fontawesome-webfont.woff2 public/dist/fonts/ 2>/dev/null; cp public/libs/bootstrap/dist/fonts/glyphicons-halflings-regular.eot public/libs/bootstrap/dist/fonts/glyphicons-halflings-regular.ttf public/libs/bootstrap/dist/fonts/glyphicons-halflings-regular.woff public/libs/bootstrap/dist/fonts/glyphicons-halflings-regular.woff2 public/dist/fonts/ 2>/dev/null; true",
    "build": "npm run build:css && npm run build:ng:prod && npm run copy:fonts",
    "dev": "npm run build:css && npm run copy:fonts && run-p dev:server dev:ng dev:css",
    "dev:server": "nodemon server.js",
    "dev:ng": "npx ng build --watch --configuration development",
    "dev:css": "chokidar 'public/less/**/*.less' -c 'npm run build:css'",
    "migrate:cross-country-to-trail": "node migrations/migrate-cross-country-to-trail.js",
    "test": "jest"
  },
  "name": "mcrrc-race-team-records",
  "main": "server.js",
  "version": "1.0.0",
  "dependencies": {
    "@angular/common": "^19.2.20",
    "@angular/compiler": "^19.2.20",
    "@angular/core": "^19.2.20",
    "@angular/forms": "^19.2.20",
    "@angular/platform-browser": "^19.2.20",
    "@angular/platform-browser-dynamic": "^19.2.20",
    "@angular/router": "^19.2.20",
    "@angular/upgrade": "^19.2.20",
    "async": "~3.2.4",
    "aws-crt": "^1.15.5",
    "axios": "^1.9.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "~1.20.0",
    "bower": "^1.8.14",
    "bson": "^1.1.1",
    "chart.js": "^3.9.1",
    "cheerio": "^1.0.0",
    "clean": "^4.0.2",
    "compression": "^1.8.1",
    "connect-flash": "^0.1.1",
    "connect-mongo": "5.1.0",
    "cookie-parser": "~1.4.6",
    "dexie": "^4.4.1",
    "dotenv": "^17.0.0",
    "ejs": "^3.1.8",
    "express": "4.19.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "1.17.3",
    "heroku-ssl-redirect": "^0.1.1",
    "method-override": "~3.0.0",
    "mongoose": "^8.3.3",
    "morgan": "~1.9.1",
    "ngx-webstorage": "^19.0.1",
    "node-schedule": "^2.1.1",
    "nodemailer": "^6.9.14",
    "passport": "~0.6.0",
    "passport-local": "~1.0.0",
    "postmark": "^0.2.6",
    "rebuild": "^0.1.2",
    "rxjs": "~7.8.0",
    "sanitize-html": "^2.17.2",
    "serve-favicon": "^2.5.0",
    "terser": "^5.16.1",
    "tslib": "^2.8.1",
    "underscore": "^1.9.1",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.23",
    "@angular/cli": "^19.2.23",
    "@angular/compiler-cli": "^19.2.20",
    "chokidar-cli": "^3.0.0",
    "clean-css-cli": "^5.6.3",
    "eslint": "^10.1.0",
    "glob": "^13.0.6",
    "jest": "^29.7.0",
    "less": "^4.6.4",
    "nodemon": "^3.1.14",
    "npm-run-all2": "^8.0.4",
    "typescript": "~5.7.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 60000,
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/public/"
    ]
  }
}
