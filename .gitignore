# Build output, regenerated by `npm run build` (also in the Docker image).
# The form stylesheets' sources live in public/css/; build-css.mjs copies them
# here. app.js is the unminified dev bundle; only app.min.js is committed.
public/dist/css/apply-form.css
public/dist/css/comprace-form.css
public/dist/js/app.js

# Brainstorming mockups (superpowers visual companion)
.superpowers/

# Safety dumps taken by scripts/restore-local.sh before it replaces the local database
backups-local/

# Member photos uploaded at runtime (app/memberPhotos.js). In production they
# live on the host (/opt/mcrrc/uploads/photos), never in git or the image.
uploads/

# Leftovers of an Angular rewrite that was started and dropped: its build
# output and the Angular CLI's cache. Nothing in the site uses them.
public/dist/ng/
.angular/

# Claude Code settings: local-only, not meant to be shared (see .vscode/
# settings.json below for the one that is).
.claude/
