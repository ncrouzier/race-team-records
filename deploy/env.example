# Copy to /opt/mcrrc/.env on the droplet and fill in. Never commit the real
# file — it holds the session secret and the database password.
#
#   cp env.example .env && chmod 600 .env

# ---- Deployment -------------------------------------------------------------
SITE_DOMAIN=records.mcrrc.org
ACME_EMAIL=you@example.com

# Which published image to run. `latest` tracks master; pin a sha- tag from the
# GitHub Actions run to roll back to a known-good build.
IMAGE_TAG=latest

# ---- Database ---------------------------------------------------------------
# Used both to initialise Mongo and to build MONGODB_URI in docker-compose.yml.
# Generate the password with: openssl rand -base64 24
MONGO_USER=mcrrc
MONGO_PASSWORD=

# ---- Application ------------------------------------------------------------
# Carry this over from Heroku unchanged. Changing it invalidates every existing
# session and logs the whole club out.
SESSION_SECRET=

SITE_URL=https://records.mcrrc.org

# ---- Mail (Brevo) -----------------------------------------------------------
# Check Brevo for IP-based sending restrictions: the droplet is a new sending
# origin and this is a common post-migration surprise.
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
MCRRC_FROM_EMAIL=
CAPTAINS_EMAIL=
CAPTAINS_EMAIL_COPY=
SEND_EMAIL_FOR_FORM=

# ---- Integrations -----------------------------------------------------------
PARKRUN_PROXY_URL=
PARKRUN_PROXY_KEY=
SIGNAL_URL=

# Do NOT set DYNO, MLAB_MONGODB_DB_URL or OPENSHIFT_MONGODB_DB_URL. They are
# legacy branches in server.js and any of them would divert the connection away
# from MONGODB_URI.
