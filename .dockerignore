# Never bake secrets into an image layer.
.env
.env.*

# Reinstalled inside the image, and a host copy would be the wrong platform.
node_modules

# Populated by `bower install` during the build.
public/libs

# Regenerated by `npm run build`. Copying the host's copy in risks shipping a
# stale bundle that silently overrides the freshly built one.
public/dist

.git
.github
.vscode
.claude
.angular
.DS_Store
**/.DS_Store

tests
doc
migrations
scripts/seed-*.js
scripts/agegrade-distribution.js

*.log
npm-debug.log
.slugignore
.openshift
README.md
HEAD_TO_HEAD_FEATURE.md

# Runtime uploads (member photos) stay on the host, out of the image
uploads

# Source artwork kept in git for generating icons/thumbnails from (e.g. the
# year-in-review share image). Nothing at runtime reads it directly — only
# the already-built derivatives (mcrrc_logo_256.png, app-icon-*.png, ...) are
# used, and those stay in the image via public/images above.
public/images/mcrrc_logo.png
