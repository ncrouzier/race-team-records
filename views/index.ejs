										<li ng-class="{active: $state.includes('/comp-race-forms')}"><a ui-sref="/comp-race-forms">Comp Race Forms</a></li>
										<li ng-class="{active: $state.includes('/volunteer-jobs')}"><a ui-sref="/volunteer-jobs">Volunteer Jobs</a></li>
