# Never bake secrets into an image layer.
.env
.env.*

# Reinstalled inside the image, and a host copy would be the wrong platform.
node_modules

# Populated by `bower install` during the build.
public/libs

# Regenerated by `npm run build`. Copying the host's copy in risks shipping a
# stale bundle that silently overrides the freshly built one.
public/dist

.git
.github
.vscode
.claude
.angular
.DS_Store
**/.DS_Store

tests
doc
migrations
scripts/seed-*.js
public/images/banners/source

*.log
npm-debug.log
.slugignore
.openshift
README.md
HEAD_TO_HEAD_FEATURE.md
