										<li ng-class="{active: $state.includes('/activitylogs')}"><a ui-sref="/activitylogs">Activity Log
											<span ng-if="unseenActivityCount > 0" ng-cloak class="crf-unseen-badge">{{unseenActivityCount}}</span></a></li>
									</ul>
								</li>
							</ul>
						</li>
						<li class="submitmenu"><a ui-sref="/instagram" target="_blank">Instagram <img
									ng-src="/images/instagramicon.svg" width="13" height="100%"></a></li>

					</ul>
					<ul class="nav navbar-nav nav-submit-admin">
