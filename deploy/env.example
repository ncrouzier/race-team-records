# Copy to /opt/mcrrc/.env on the droplet and fill in. Never commit the real
# file — it holds the session secret and the database password.
#
#   cp env.example .env && chmod 600 .env

# ---- Deployment -------------------------------------------------------------
SITE_DOMAIN=records.mcrrc.org
ACME_EMAIL=you@example.com

# Which published image to run. `latest` tracks master; pin a sha- tag from the
# GitHub Actions run to roll back to a known-good build.
IMAGE_TAG=latest

# ---- Database ---------------------------------------------------------------
# Used both to initialise Mongo and to build MONGODB_URI in docker-compose.yml.
#
# Generate with:  openssl rand -hex 24
#
# Hex, not base64, on purpose. base64 emits + / and =, and this value is
# interpolated straight into a mongodb:// URI, where the spec requires
# : / ? # [ ] @ to be percent-encoded. A / in the password silently breaks URI
# parsing. ($ and # would also confuse .env parsing.) Hex avoids all of it.
MONGO_USER=mcrrc
MONGO_PASSWORD=

# ---- Application ------------------------------------------------------------
# Carry this over from Heroku unchanged. Changing it invalidates every existing
# session and logs the whole club out.
SESSION_SECRET=

SITE_URL=https://records.mcrrc.org

# ---- Mail (Brevo) -----------------------------------------------------------
# Check Brevo for IP-based sending restrictions: the droplet is a new sending
# origin and this is a common post-migration surprise.
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
MCRRC_FROM_EMAIL=
CAPTAINS_EMAIL=
CAPTAINS_EMAIL_COPY=
SEND_EMAIL_FOR_FORM=

# ---- Backups ----------------------------------------------------------------
# Read by deploy/backup.sh, which runs weekly from cron. Both retentions are in
# days, so with a weekly schedule they work out as a number of copies: 35 days
# is five local, 90 days is about thirteen in Drive. Drive keeps more because
# that is the copy that survives losing the droplet.
RETAIN_DAYS=35

# Leave GDRIVE_REMOTE blank to keep local-only backups. GDRIVE_REMOTE is the
# rclone remote name with no colon — check it with `rclone listremotes`. See
# the setup notes at the top of backup.sh: the OAuth step has to happen on a
# machine with a browser, not on the droplet.
GDRIVE_REMOTE=gdrive
GDRIVE_FOLDER=mcrrc-backups
GDRIVE_RETAIN_DAYS=90

# ---- Integrations -----------------------------------------------------------
PARKRUN_PROXY_URL=
PARKRUN_PROXY_KEY=
SIGNAL_URL=

# Do NOT set DYNO, MLAB_MONGODB_DB_URL or OPENSHIFT_MONGODB_DB_URL. They are
# legacy branches in server.js and any of them would divert the connection away
# from MONGODB_URI.
