<!doctype html>
<html ng-app="mcrrcApp">

<head>
	<base href="/">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title><%= ogTitle || 'MCRRC Racing Team' %></title>
	<link rel="stylesheet" type="text/css" href="dist/css/style.min.css">
	<link rel="stylesheet" type="text/css" href="libs/nouislider/dist/nouislider.min.css">
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
	<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
	<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&display=swap" rel="stylesheet">
	<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@800&family=Barlow+Semi+Condensed:wght@600&display=swap" rel="stylesheet">
	<script src="//cdnjs.cloudflare.com/ajax/libs/d3/3.5.3/d3.min.js"></script>
	<script src="//cdnjs.cloudflare.com/ajax/libs/topojson/1.6.9/topojson.min.js"></script>
	<script src="//cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
	<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
	<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
	<!-- <script src="https://unpkg.com/dexie@4.0.5/dist/dexie.js"></script> -->
	<script src="libs/tinymce/tinymce.min.js"></script>
	<!-- Use EJS variable for script path -->
	<script src="<%= scriptPath %>"></script>

	<!-- Google Analytics. Page views are sent by the app, one per page
	     (public/js/app.js), hence send_page_view: false; events go through
	     the Analytics service. user_role starts as the role the server
	     sees, so the first page view has it; the app follows a log in or
	     out from there. -->
	<%- include('partials/ga', { gaConfig: { send_page_view: false }, gaUserRole: user && user.role ? user.role : 'anonymous' }) %>
	<!-- Per-page where there is one (a race, a result, a member): set
	     server-side in app/routes.js's catch-all route, before this renders —
	     a link-preview crawler (iMessage, Slack, Facebook...) reads these tags
	     without ever running the client JS that drives the tab title. -->
	<meta property="og:site_name" content="MCRRC Racing Team" />
	<meta property="og:title" content="<%= ogTitle %>" />
	<meta property="og:type" content="website" />
	<meta property="og:url" content="<%= ogUrl %>" />
	<meta property="og:image" content="<%= ogImage %>" />
	<meta property="og:description" content="<%= ogDescription %>" />
	<meta name="description" content="<%= ogDescription %>" />
	<meta name="twitter:card" content="summary" />
	<meta name="twitter:title" content="<%= ogTitle %>" />
	<meta name="twitter:description" content="<%= ogDescription %>" />
	<meta name="twitter:image" content="<%= ogImage %>" />
	<link rel="image_src" href="<%= ogImage %>" />
</head>

<body ng-controller="MainController">
	<div class="container">

		<div ng-style="bannerStyle" class="row navimg">
			<div class="banner-title banner-title-{{bannerTitlePosition}}" ng-class="{'banner-title-hidden': bannerTitleHidden}" ng-click="toggleBannerTitle()">
				<div class="banner-title-top">Montgomery County Road Runners</div>
				<div class="banner-title-bottom">Racing Team</div>
			</div>
			<a ng-if="bannerCopyright" class="banner-copyright" ng-href="{{bannerCopyright.url}}" ng-style="bannerCopyrightStyle" target="_blank" rel="noopener noreferrer">&#169; {{bannerCopyright.name}}</a>
			<div class="">
				<div class="logo-stats">
					<!-- <span tooltip-append-to-body="true" tooltip-placement="bottom"
						uib-tooltip-html="'View Progress Map'" ng-cloak ng-if="milesRaced"><a
							ui-sref="/stats/progress-map"><img src="/images/route.svg"
								style="width: 1em; height: 1em; vertical-align: top;">
							{{milesRaced}} miles raced in
							{{currentYear}}!</a></span> -->

					<div class="uib-dropdown" uib-dropdown style="font-size: 13px;">
						<a href class="uib-dropdown-toggle submit-btn" uib-dropdown-toggle>
							Submit <span class="caret"></span>
						</a>
						<ul class="dropdown-menu dropdown-menu-right" uib-dropdown-menu>
							<li><a ui-sref="/submitresult" target="_blank">Submit a Result</a></li>
							<li><a ui-sref="/submitvolunteer" target="_blank">Submit a Volunteer Job</a></li>
						</ul>
					</div>

				</div>
			</div>
			<div class="birthdaytext" ng-if="birthdays.length >0" ng-cloak>
				<span>🎂Happy Birthday <span ng-repeat="m in birthdays track by $index"><a
							ui-sref="/members/member({ member: m.username}) ">{{m.firstname}} {{m.lastname}}</a><span
							ng-if="birthdays.length >1 && $index < birthdays.length-2">, </span> <span
							ng-if="birthdays.length >1  && $index < birthdays.length-1 && $index !== birthdays.length-1  && $index === birthdays.length-2">
							and </span></span>!🎂</span>
			</div>
		</div>

		<!-- HEADER -->
		<nav class="navbar navbar-inverse">
			<div class="navbar-header">

				<button type="button" title="Navigation button" class="navbar-toggle" ng-init="navCollapsed = true"
					ng-click="navCollapsed = !navCollapsed">
					<span class="icon-bar"></span>
					<span class="icon-bar"></span>
					<span class="icon-bar"></span>
				</button>
			</div>
			<div class="collapse navbar-collapse" ng-class="!navCollapsed && 'in'">
				<% if (user && user.role==='admin' ) { %>
					<ul class="nav navbar-nav">
						<li ng-class="{active: $state.includes('/')}"><a ui-sref="/">Home</a></li>
						<li ng-class="{active: $state.includes('/records')}" class="uib-dropdown" uib-dropdown
							on-toggle="toggled(open)">
							<a href style="padding:12px 5px 12px 5px;" class="uib-dropdown-toggle"
								uib-dropdown-toggle>Records <i class="fa fa-trophy"></i> <span class="caret"></span></a>
							<ul class="dropdown-menu" uib-dropdown-menu>
								<li ng-class="{active: $state.is('/records')}"><a ui-sref="/records"> <i
											class="fa fa-trophy"></i> Best Performances</a></li>
								<li ng-class="{active: $state.is('/records/age')}"><a ui-sref="/records/age"> <i
											class="fa fa-th"></i> Records by Age</a></li>
								<li ng-class="{active: $state.is('/records/year')}"><a ui-sref="/records/year"> <i
											class="fa fa-th"></i> Records by Year</a></li>
							</ul>
						</li>
						<!-- Split: the name goes to the race list, the caret opens the menu -->
						<li ng-class="{active: $state.includes('/results') || $state.includes('/races') || $state.includes('/individualresults') || $state.includes('/series') || $state.includes('/series-detail')}"
							class="uib-dropdown nav-split-dropdown" uib-dropdown on-toggle="toggled(open)">
							<a ui-sref="/results" class="nav-split-main">Team Results <i class="fa fa-list"></i></a>
							<a href class="uib-dropdown-toggle nav-split-caret" uib-dropdown-toggle
								title="More ways to see results"><span class="caret"></span></a>
							<ul class="dropdown-menu" uib-dropdown-menu>
								<li ng-class="{active: $state.includes('/individualresults')}"><a ui-sref="/individualresults"
										ui-sref-opts="{inherit: false}" track-event="view_switch"
						track-params="{to: 'individual_results', via: 'navbar'}">Individual Results <i class="fa fa-user"></i></a></li>
								<li ng-class="{active: $state.includes('/series') || $state.includes('/series-detail')}"><a ui-sref="/series">Race Series <i class="fa fa-calendar-check-o"></i></a></li>
