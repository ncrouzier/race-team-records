										<li
											ng-class="{active: $state.includes('/tools/paceAdjustment') || $state.includes('/moist')}">
											<a ui-sref="/tools/paceAdjustment">Temperature + Dew Point adjustment</a>
										</li>
									</ul>
								</li>
								<li class="submitmenu"><a ui-sref="/instagram" target="_blank">Instagram <img
											ng-src="/images/instagramicon.svg" width="13" height="100%"></a></li>
							</ul>
							<ul class="nav navbar-nav nav-submit-admin">
								<li ng-class="{active: ($state.includes('/profile'))}" class="uib-dropdown" uib-dropdown
									on-toggle="toggled(open)">
									<a href style="padding:12px 5px 12px 5px;" class="uib-dropdown-toggle"
										uib-dropdown-toggle>
										<%= user.username %> <span class="caret"></span>
									</a>
									<ul class="dropdown-menu" uib-dropdown-menu>
										<li><a ui-sref="/profile">My Account</a></li>
										<% if (user.member) { %>
											<li><a ui-sref="/members/member({member: '<%= user.member.username %>'})">My
													Page</a></li>
											<% } %>
												<li><a ng-click="logout()">Logout</a></li>
									</ul>
								</li>
							</ul>

							<%}else{ %>
								<ul class="nav navbar-nav">
									<li ng-class="{active: $state.includes('/')}"><a ui-sref="/">Home</a></li>
									<li ng-class="{active: $state.includes('/records')}" class="uib-dropdown"
										uib-dropdown on-toggle="toggled(open)">
										<a href style="padding:12px 5px 12px 5px;" class="uib-dropdown-toggle"
											uib-dropdown-toggle>Records <i class="fa fa-trophy"></i> <span
												class="caret"></span></a>
										<ul class="dropdown-menu" uib-dropdown-menu>
											<li ng-class="{active: $state.is('/records')}"><a ui-sref="/records"> <i
														class="fa fa-trophy"></i> Best Performances</a></li>
											<li ng-class="{active: $state.is('/records/age')}"><a
													ui-sref="/records/age"> <i class="fa fa-th"></i> Records by Age</a>
											</li>
											<li ng-class="{active: $state.is('/records/year')}"><a
													ui-sref="/records/year"> <i class="fa fa-th"></i> Records by
													Year</a>
											</li>
										</ul>
									</li>
									<!-- Split: the name goes to the race list, the caret opens the menu -->
									<li ng-class="{active: $state.includes('/results') || $state.includes('/races') || $state.includes('/individualresults') || $state.includes('/series') || $state.includes('/series-detail')}"
										class="uib-dropdown nav-split-dropdown" uib-dropdown on-toggle="toggled(open)">
										<a ui-sref="/results" class="nav-split-main">Team Results <i class="fa fa-list"></i></a>
										<a href class="uib-dropdown-toggle nav-split-caret" uib-dropdown-toggle
											title="More ways to see results"><span class="caret"></span></a>
										<ul class="dropdown-menu" uib-dropdown-menu>
											<li ng-class="{active: $state.includes('/individualresults')}"><a ui-sref="/individualresults"
													ui-sref-opts="{inherit: false}" track-event="view_switch"
						track-params="{to: 'individual_results', via: 'navbar'}">Individual Results <i class="fa fa-user"></i></a></li>
								<li ng-class="{active: $state.includes('/series') || $state.includes('/series-detail')}"><a ui-sref="/series">Race Series <i class="fa fa-calendar-check-o"></i></a></li>
										</ul>
									</li>
									<li ng-class="{active: $state.includes('/members')}"><a ui-sref="/members">Team
											Members
											<i class="fa fa-users"></i></a></li>
									<li ng-class="{active: $state.includes('/stats')}"><a ui-sref="/stats">Stats <i
												class="fa fa-bar-chart"></i></a></li>
									<li ng-class="{active: ($state.includes('/tools/agegrade') || $state.includes('/tools/paceAdjustment') || $state.includes('/moist'))}"
										class="uib-dropdown" uib-dropdown on-toggle="toggled(open)">
										<a href style="padding:12px 5px 12px 5px;" class="uib-dropdown-toggle"
											uib-dropdown-toggle>Tools <i class="fa fa-wrench"></i> <span
												class="caret"></span>
										</a>
										<ul class="dropdown-menu" uib-dropdown-menu>
											<li ng-class="{active: $state.includes('/tools/agegrade')}"><a
													ui-sref="/tools/agegrade">Age Grade</a></li>
											<li
												ng-class="{active: $state.includes('/tools/paceAdjustment') || $state.includes('/moist')}">
												<a ui-sref="/tools/paceAdjustment">Temperature + Dew Point
													adjustment</a>
											</li>
										</ul>
									</li>
									<li class="submitmenu"><a ui-sref="/instagram" target="_blank">Instagram <img
												ng-src="/images/instagramicon.svg" width="13" height="100%"></a></li>
								</ul>


								<ul class="nav navbar-nav nav-submit-admin">
									<li><a ui-sref="/login">Login <i class="fa fa-sign-in"></i></a></li>
								</ul>
								<%}%>
			</div><!-- /.navbar-collapse -->
		</nav>

		<div ui-view></div>
		<footer>
			<div class="row">
				<div class="col-sm-5 text-left">Site by <a class="hoverhand"
						ui-sref="/members({member: 'nicolascrouzier'})">Nicolas Crouzier</a>. <span class="">Want to
						support the site and its creator? <a class="bold red"
							href="https://www.paypal.com/donate/?business=KN2D558FKKYQQ&no_recurring=1&item_name=Support+the+maintenance+of+the+team+result+site+by+buying+me+a+coffee+or+helping+me+pay+Strava+premium+membership!+Thank+you!&currency_code=USD">Buy
							me a coffee!</a></span></div>
				<div class="col-sm-2 text-center"><a class="transparent" ui-sref="/login">login</a></div>
				<div class="col-sm-5 text-right"><a ui-sref="/about">About Age Grading</a> --- <a
						title="Montgomery County Road Runners Club" href="https://www.mcrrc.org"
						target="_blank">MCRRC</a></div>
			</div>
			<div class="row">
				<div class="col-sm-12 text-center site-build">
					<span class="site-build-version"<% if (buildDate) { %> build-stamp="<%= buildDate %>"<% } %>><%= appVersion %></span>
				</div>
			</div>
		</footer>
	</div>

</body>

</html>